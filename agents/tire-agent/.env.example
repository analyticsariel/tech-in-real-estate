# tire-agent configuration. Copy to .env and fill in. Never commit the real file.

# AWS: Claude runs on Amazon Bedrock. The agent refuses any account but this one.
TIRE_AWS_PROFILE=
TIRE_AWS_ACCOUNT_ID=
TIRE_AWS_REGION=us-east-1

# LangSmith tracing and evals
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tire-agent-dev

# Optional
TIRE_AGENT_MODEL=
TIRE_DB=
